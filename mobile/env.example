# Phone: use a reachable HTTPS API; 127.0.0.1 on a phone is the phone itself.
EXPO_PUBLIC_API_URL=https://api.your-numerom-domain.example
EXPO_PUBLIC_SITE_URL=https://your-numerom-domain.example
# Set production for a release build; it requires explicit HTTPS API configuration.
APP_VARIANT=development

# Official browser app runs on 1.numer.om; leave empty for native builds.
EXPO_PUBLIC_WEB_BASE_PATH=
