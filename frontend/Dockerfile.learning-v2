# Build from repository root: docker build -f frontend/Dockerfile.learning-v2 .
# ===== FRONTEND ДЛЯ СИСТЕМЫ ОБУЧЕНИЯ V2 =====

# Используем Node.js для сборки
FROM node:22-alpine AS builder

# Устанавливаем рабочую директорию
WORKDIR /app/frontend

# Копируем package.json и package-lock.json
COPY frontend/package*.json ./

# Устанавливаем зависимости
RUN npm install --legacy-peer-deps

# Копируем исходный код
COPY frontend/ .
COPY packages/api-client/ /app/packages/api-client/

# Собираем приложение
RUN npm run build

# ===== NGINX ДЛЯ РАЗДАЧИ СТАТИКИ =====
FROM nginx:alpine

# Копируем собранное приложение
COPY --from=builder /app/frontend/build /usr/share/nginx/html

# Копируем конфигурацию nginx для learning-v2
COPY frontend/nginx.learning-v2.conf /etc/nginx/conf.d/default.conf

# Создаем необходимые директории
RUN mkdir -p /usr/share/nginx/html/uploads

# Открываем порт 80
EXPOSE 80

# Запускаем nginx
CMD ["nginx", "-g", "daemon off;"]




